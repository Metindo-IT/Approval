<odoo>

    <!-- 1. list view -->
    <record id="view_academic_session_list" model="ir.ui.view">
        <field name="name">academic.session.list</field>
        <field name="model">academic.session</field>
        <field name="type">list</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <list decoration-info="duration &lt; 5" 
                  decoration-danger="duration &gt; 15">
                <field name="name"/>
                <field name="course_id"/>
                <field name="instructor_id"/>
                <field name="start_date"/>
                <field name="duration"/>
                <field name="seats"/>
                <field name="taken_seats" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- 2. form view -->
    <record id="view_academic_session_form" model="ir.ui.view">
        <field name="name">academic.session.form</field>
        <field name="model">academic.session</field>
        <field name="type">form</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_tittle">
                        <label for="name" class="oe_edit_only" string="Session Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        <group>
                            <group>
                                <field name="course_id"/>
                                <field name="instructor_id"/>
                                <field name="instructor_id" domain="[('is_instructor', '=', True)]"/>
                                <field name="taken_seats" widget="progressbar"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="duration"/>
                                <field name="seats"/>
                            </group>
                        </group>
                        <notebook> 
                            <page string="Attendees"> 
                                <field name="attendee_ids">
                                    <list editable="bottom">
                                <field name="partner_id"/> 
                                    </list> 
                                </field> 
                            </page> 
                        </notebook>
                        </div>
                    </sheet>
                </form>
        </field>
    </record>

    <!-- 4. calendar -->
    <record id="view_academic_session_calendar" model="ir.ui.view"> 
        <field name="name">academic.session.calendar</field> 
        <field name="model">academic.session</field> 
        <field name="type">calendar</field> 
        <field name="arch" type="xml"> 
            <calendar date_start="start_date" date_stop="end_date" color="instructor_id" mode="month"> 
                <field name="name"/> 
                <field name="instructor_id"/> 
            </calendar> 
        </field> 
    </record>

    <!-- 5. search -->
    <record id="view_academic_session_search" model="ir.ui.view"> 
        <field name="name">academic.session.search</field> 
        <field name="model">academic.session</field> 
        <field name="arch" type="xml"> 
            <search> 
                <field name="name"/> 
                <field name="instructor_id"/> 
                <filter name="my_courses" string="My Courses" domain="[('course_id.responsible_id', '=', uid)]"/> 
                <separator/> 
                <filter name="by_course" string="Course" context="{'group_by': 'course_id'}"/> 
                <filter name="by_date" string="Start Date" context="{'group_by': 'start_date'}"/> 
            </search> 
        </field> 
    </record>

    <record id="view_academic_session_graph" model="ir.ui.view"> 
        <field name="name">academic.session.graph</field> 
        <field name="model">academic.session</field> 
        <field name="arch" type="xml"> 
            <graph type="bar"> 
                <field name="course_id"/> 
                <field name="taken_seats" type="measure"/> 
            </graph> 
        </field> 
    </record>

    <record id="view_academic_session_pivot" model="ir.ui.view"> 
        <field name="name">academic.session.pivot</field> 
        <field name="model">academic.session</field> 
        <field name="arch" type="xml"> 
            <pivot> 
                <field name="course_id" type="row"/> 
                <field name="start_date" interval="month" type="col"/> 
                <field name="seats" type="measure"/> 
            </pivot> 
        </field> 
    </record>

    <record id="view_academic_session_kanban" model="ir.ui.view"> 
        <field name="name">academic.session.kanban</field> 
        <field name="model">academic.session</field> 
        <field name="arch" type="xml"> 
            <kanban default_group_by="course_id"> 
                <templates> 
                    <t t-name="card"> 
                        <field name="image" widget="image" options="{'size': [64, 64]}"/> 
                        <field name="name" class="fw-bold fs-5"/> 
                        <field name="instructor_id"/> 
                        <field name="taken_seats" widget="progressbar"/> 
                    </t> 
                </templates> 
            </kanban> 
        </field> 
    </record>

    <!-- 3. action -->
    <record id="action_session_list" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">academic.session</field>
        <!-- <field name="view_mode">list,form</field>
        <field name="view_mode">list,form,calendar</field> -->
        <field name="view_mode">list,form,calendar,graph,pivot,kanban</field>
    </record> 

</odoo>