<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_vendor_pricelist_approval" model="ir.module.category">
            <field name="name">Vendor Pricelist Approval</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_vendor_pricelist_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_vendor_pricelist_approval"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_vendor_pricelist_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_vendor_pricelist_approval"/>
            <field name="implied_ids" eval="[(4, ref('group_vendor_pricelist_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_vendor_pricelist_approval_user" model="ir.rule">
            <field name="name">Vendor Pricelist Approval: Creator / Approver / Follower</field>
            <field name="model_id" ref="model_vendor_pricelist_approval"/>
            <field name="groups" eval="[(4, ref('group_vendor_pricelist_user'))]"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('line_ids.user_id', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        </record>

        <record id="rule_vendor_pricelist_approval_manager" model="ir.rule">
            <field name="name">Vendor Pricelist Approval: Manager See All</field>
            <field name="model_id" ref="model_vendor_pricelist_approval"/>
            <field name="groups" eval="[(4, ref('group_vendor_pricelist_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
