<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_apv_new_form" model="ir.ui.view">
        <field name="name">apv.new.request.form</field>
        <field name="model">apv.new.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_apv_new_tree" model="ir.ui.view">
        <field name="name">apv.new.request.tree</field>
        <field name="model">apv.new.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_apv_new_request" model="ir.actions.act_window">
        <field name="name">Approvals New</field>
        <field name="res_model">apv.new.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Utama -->
    <menuitem id="menu_apv_new_root" name="APV New" sequence="10"/>
    <menuitem id="menu_apv_new_request" name="Requests" parent="menu_apv_new_root" action="action_apv_new_request" sequence="10"/>
</xml>