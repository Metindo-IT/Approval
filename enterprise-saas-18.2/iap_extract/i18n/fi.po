#. module: iap_extract
#: model:mail.template,body_html:iap_extract.iap_extract_no_credit
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear,<br/></p>\n"
"    <p>There are no more credits on your IAP OCR account.<br/>\n"
"    You can charge your IAP OCR account in the settings page.</p>\n"
"    <p>Best regards,<br/></p>\n"
"    <p>Odoo S.A.</p>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hyvä,<br></p>\n"
"    <p>Sovelluksen sisäisten hahmontunnistukseen käytettävien krediittien (IAP OCR) tililläsi ei ole enää krediittejä.<br>\n"
"    Voit ladata lisää IAP OCR -krediittejä tiliisi asetussivulla.</p>\n"
"    <p>Ystävällisin terveisin,<br></p>\n"
"    <p>Odoo S.A.</p>\n"
"</div>"

